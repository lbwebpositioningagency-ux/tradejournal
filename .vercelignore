# File che non devono finire nell'upload verso Vercel.
# Senza questo, il deploy da CLI carica anche l'output di build locale
# (.next, oltre 2 GB dopo qualche build) e gli screenshot di verifica
# (docs/, decine di MB): l'upload si interrompe.

node_modules
.next
out

# Screenshot before/after delle fasi: documentazione, non codice servito.
docs

# Verifiche e strumenti che girano solo in locale.
coverage
# `scripts/*` e non `scripts`: escludere la CARTELLA renderebbe impossibile
# ri-ammettere un file al suo interno (stessa regola di .gitignore). Serve
# perche' `prepare` gira anche sul build di Vercel e il file deve esistere,
# altrimenti node muore con MODULE_NOT_FOUND e `npm install` esce 1.
scripts/*
!scripts/setup-hooks.mjs

# Expert Advisor MetaTrader: si installa nel terminale, non sul server.
mt5
