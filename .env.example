# Copia questo file in .env e compila i valori.
# DB locale: avvia con `docker compose up -d` (vedi docker-compose.yml)
DATABASE_URL="postgresql://tradejournal:tradejournal@localhost:5432/tradejournal"

# Genera con: npx auth secret  (oppure una stringa random base64 di 32 byte)
AUTH_SECRET=""

# OAuth Google (opzionale in locale): https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Necessario con `next start` self-hosted (in dev il trust dell'host e' implicito)
AUTH_TRUST_HOST=true

# Bearer token dell'endpoint POST /api/macro-desk (report macro dal sistema esterno).
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MACRO_DESK_API_SECRET=""

# Watcher MT5 (S-01/P-10). Il sync legge file NDJSON scritti dall'EA sul
# filesystem LOCALE: funziona solo con l'app in esecuzione locale o
# self-hosted sulla stessa macchina di MetaTrader. Su Vercel quei percorsi
# non esistono, quindi lì va semplicemente lasciato spento.
#
# INTERRUTTORE INVERTITO (SECURITY_AUDIT P2-9): il watcher parte SOLO con
# MT5_WATCHER_ENABLED=1. Variabile assente = spento. Prima era il contrario
# (MT5_WATCHER_DISABLED=1 per spegnerlo) e dimenticarla lo lasciava acceso
# in produzione — che è precisamente ciò che era successo.
MT5_WATCHER_ENABLED=""

# Cartella base entro cui devono stare i file dell'EA. OBBLIGATORIA se il
# watcher è abilitato: i percorsi salvati dagli utenti vengono risolti e
# rifiutati se finiscono fuori di qui, così un percorso arbitrario non può
# far leggere al server file che non c'entrano.
# Esempio Windows: C:\Users\tuonome\AppData\Roaming\MetaQuotes\Terminal\<id>\MQL5\Files
MT5_WATCH_DIR=""

# Chiave API FRED per la pagina Macro Desk → Trends (gratuita e immediata:
# https://fredaccount.stlouisfed.org/apikeys). OPZIONALE: senza chiave la
# pagina usa il CSV pubblico keyless di FRED (fredgraph.csv). Su Vercel va
# impostata in Settings → Environment Variables (Production + Preview).
FRED_API_KEY=""
