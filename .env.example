# Copia questo file in .env e compila i valori.
# DB locale: avvia con `docker compose up -d` (vedi docker-compose.yml)
DATABASE_URL="postgresql://tradejournal:tradejournal@localhost:5432/tradejournal"

# Genera con: npx auth secret  (oppure una stringa random base64 di 32 byte)
AUTH_SECRET=""

# OAuth Google (opzionale in locale): https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Necessario con `next start` self-hosted (in dev il trust dell'host e' implicito)
AUTH_TRUST_HOST=true
