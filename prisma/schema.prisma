generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Auth.js v5 ─────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  passwordHash    String? // null se l'utente usa solo OAuth
  image           String?
  timezone        String    @default("Europe/Rome")
  baseCurrency    String    @default("USD")
  dashboardLayout Json? // layout widget dashboard (FASE 5)

  accounts        Account[]
  sessions        Session[]
  tradingAccounts TradingAccount[]
  strategies      Strategy[]
  tags            Tag[]
  notes           Note[]
  importProfiles  ImportProfile[]
  mt5SyncSources  Mt5SyncSource[]
  attachments     Attachment[]
  checklistItems  ChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────── Dominio trading ─────────────────────────

enum AssetClass {
  STOCK
  FUTURES
  FOREX
  CRYPTO
  OPTION
}

enum TradeDirection {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum ExecutionSide {
  BUY
  SELL
}

enum TagCategory {
  SETUP
  MISTAKE
  EMOTION
  CUSTOM
}

enum NoteType {
  TRADE // nota su un singolo trade
  DAILY // journal di giornata (Day View)
  NOTEBOOK // nota libera / con template
}

// F3 — momento del testo scritto SU UN TRADE. Prima esisteva un campo note
// unico: il piano scritto prima di entrare e la revisione scritta dopo aver
// visto l'esito finivano nello stesso testo, e diventava impossibile
// distinguere l'analisi dal senno di poi.
enum TradeNotePhase {
  PLAN // scritto PRIMA: perché entro, cosa mi aspetto
  REVIEW // scritto DOPO: com'è andata davvero
}

// Fase del journal giornaliero (Day View a 3 campi)
enum DayPhase {
  PREMARKET // prima dell'apertura
  INMARKET // durante la sessione
  POSTMARKET // dopo la chiusura
}

model TradingAccount {
  id             String  @id @default(cuid())
  userId         String
  name           String
  broker         String?
  currency       String  @default("USD")
  initialBalance Decimal @default(0) @db.Decimal(14, 2)
  isArchived     Boolean @default(false)

  // Conto DEMO globale (SIM1): appartiene a un utente di sistema ed è
  // visibile in sola lettura a TUTTI gli utenti (una sola copia condivisa).
  // Non entra mai in "Tutti i conti": lo scope demo si attiva solo quando il
  // conto è selezionato esplicitamente (vedi src/lib/demo-account.ts).
  isDemo Boolean @default(false)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades        Trade[]
  mt5SyncSource Mt5SyncSource?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Trade {
  id               String         @id @default(cuid())
  tradingAccountId String
  symbol           String
  assetClass       AssetClass     @default(STOCK)
  direction        TradeDirection
  status           TradeStatus    @default(OPEN)

  openedAt DateTime // UTC, timestamp della prima execution
  closedAt DateTime? // UTC, timestamp dell'ultima execution quando la posizione è flat

  // Moltiplicatore del contratto: P&L = Δprezzo × qty × pointValue.
  // Es. ES=50, NQ=20, forex (qty in lotti)=100000, azioni/crypto=1.
  pointValue Decimal @default(1) @db.Decimal(18, 8)

  // Campi denormalizzati: ricalcolati dalle executions a ogni scrittura.
  quantity      Decimal  @db.Decimal(18, 8) // size massima raggiunta
  avgEntryPrice Decimal  @db.Decimal(18, 8)
  avgExitPrice  Decimal? @db.Decimal(18, 8)
  grossPnl      Decimal  @default(0) @db.Decimal(14, 2)
  fees          Decimal  @default(0) @db.Decimal(14, 2)
  // Swap / rollover / finanziamento notturno: costo di POSIZIONE, non di
  // esecuzione — matura mentre il trade resta aperto, quindi non può stare
  // sulla Execution come la fee. Segno libero: uno swap può essere un
  // accredito. netPnl = grossPnl − fees − swap.
  swap          Decimal  @default(0) @db.Decimal(14, 2)
  netPnl        Decimal  @default(0) @db.Decimal(14, 2)

  initialRisk   Decimal? @db.Decimal(14, 2) // rischio $ pianificato → R-multiple
  plannedStop   Decimal? @db.Decimal(18, 8)
  plannedTarget Decimal? @db.Decimal(18, 8)
  rMultiple     Decimal? @db.Decimal(10, 4) // netPnl / initialRisk, denormalizzato
  // Target R del piano: |target − entry| / |entry − stop| (segni per direzione).
  // Denormalizzato come rMultiple e calcolato dalla STESSA funzione
  // (metrics/plan.ts → targetRMultiple): le distribuzioni per target R si
  // aggregano in SQL senza ri-derivare la formula altrove.
  targetR       Decimal? @db.Decimal(10, 4)

  strategyId String?
  rating     Int? // 1-5, opzionale

  // Id posizione del broker (sync MT5): la dedup è PER CONTO, non globale —
  // i ticket MT5 sono sequenziali per server e broker diversi possono riusarli.
  brokerTicketId String?

  account     TradingAccount        @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  strategy    Strategy?             @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  executions  Execution[]
  tags        TradeTag[]
  notes       Note[]
  attachments Attachment[]
  checklist   TradeChecklistCheck[]
  review      TradeReview?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tradingAccountId, brokerTicketId])
  @@index([tradingAccountId, openedAt])
  // P-09: il 90% delle query analitiche filtra il range e ordina su closedAt
  // (whereClosedTrades, getRecentTradeOutcomes, getTradeSequence) — copre i
  // range e gli ORDER BY per conto; oggi ininfluente (~1k righe), evita i
  // seq scan ripetuti quando i trade saranno decine di migliaia.
  @@index([tradingAccountId, closedAt])
  @@index([tradingAccountId, symbol])
  @@index([tradingAccountId, status])
  @@index([strategyId])
}

model Execution {
  id         String        @id @default(cuid())
  tradeId    String
  side       ExecutionSide
  quantity   Decimal       @db.Decimal(18, 8)
  price      Decimal       @db.Decimal(18, 8)
  fee        Decimal       @default(0) @db.Decimal(14, 2)
  executedAt DateTime // UTC

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId, executedAt])
}

model Strategy {
  id          String  @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String? // hex per grafici/badge
  isArchived  Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Tag {
  id       String      @id @default(cuid())
  userId   String
  name     String
  category TagCategory @default(CUSTOM)
  color    String?

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades TradeTag[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model TradeTag {
  tradeId String
  tagId   String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
  @@index([tagId])
}

model Note {
  id         String          @id @default(cuid())
  userId     String
  type       NoteType        @default(NOTEBOOK)
  tradeId    String?
  dayDate    DateTime?       @db.Date // per type=DAILY: giorno nel fuso dell'utente
  dayPhase   DayPhase? // per type=DAILY: fase del journal (3 campi per giorno)
  // per type=TRADE: piano (prima) o revisione (dopo). null = nota storica
  // scritta quando il campo era uno solo: non si riscrive il passato.
  tradePhase TradeNotePhase?
  title      String?
  content    String // markdown

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade       Trade?       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayDate, dayPhase]) // un journal per giorno E fase
  @@unique([tradeId, tradePhase]) // un piano e una revisione per trade
  @@index([userId, type])
  @@index([tradeId])
}

/**
 * F3 — CHECKLIST PRE-TRADE RIUTILIZZABILE.
 * Le voci sono dell'utente e vivono nel tempo; le spunte sono del singolo
 * trade e non cambiano mai più. `TradeChecklistCheck` porta una COPIA
 * dell'etichetta al momento della spunta: rinominare una voce non deve
 * riscrivere che cosa hai verificato tre mesi fa.
 */
model ChecklistItem {
  id         String  @id @default(cuid())
  userId     String
  label      String
  position   Int     @default(0)
  isArchived Boolean @default(false)

  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks TradeChecklistCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, label])
  @@index([userId, isArchived])
}

model TradeChecklistCheck {
  tradeId String
  itemId  String
  checked Boolean @default(false)
  /**
   * Etichetta al momento della spunta: il passato non si riscrive.
   */
  label   String

  trade Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  item  ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([tradeId, itemId])
  @@index([itemId])
}

/**
 * F3 — REVISIONE POST-MORTEM STRUTTURATA.
 * Tre domande fisse invece di un campo libero: un box vuoto produce "bene"
 * e "male", tre domande producono una revisione. `followedPlan` è l'unico
 * campo che si può AGGREGARE — «win rate quando ho seguito il piano contro
 * quando no» è la riga che trasforma il journaling in una misura.
 */
model TradeReview {
  tradeId      String   @id
  /**
   * Il trade ha seguito il piano? null = non ancora risposto.
   */
  followedPlan Boolean?
  whatWorked   String?
  whatFailed   String?
  nextTime     String?

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id      String    @id @default(cuid())
  userId  String // proprietario: filtro di sicurezza diretto, senza join
  tradeId String?
  noteId  String?
  dayDate DateTime? @db.Date // allegato di GIORNATA (Day View): chiave giorno nel fuso utente

  fileName String
  filePath String // locator dello storage: "db" = byte nella colonna `data`
  mimeType String
  size     Int
  // Byte del file in Postgres: self-contained e persistente anche su Vercel
  // (filesystem effimero); mai in SELECT di listing, solo nella route di download.
  data     Bytes

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade Trade? @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  note  Note?  @relation(fields: [noteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tradeId])
  @@index([noteId])
  @@index([userId, dayDate])
}

// ───────────────────────── Import CSV (FASE 3) ─────────────────────────

model ImportProfile {
  id      String @id @default(cuid())
  userId  String
  name    String
  mapping Json // { colonna CSV → campo, formato date, separatori, ecc. }

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, name])
}

// ───────────────────────── Macro Desk ─────────────────────────

enum MacroReportType {
  DAILY
  WEEKLY
}

// Report macro (oro/petrolio/indici) inviato da un sistema esterno via API.
// Dato di MERCATO unico per l'istanza, NON per utente: nessun userId.
// Chiave logica (type, reportDate): il re-invio dello stesso report è un upsert.
model MacroDeskReport {
  id          String          @id @default(cuid())
  type        MacroReportType
  reportDate  DateTime        @db.Date // giorno del report (mezzanotte UTC)
  generatedAt DateTime // quando il sistema esterno l'ha generato

  // Bias direzionale per asset: "RIALZISTA" | "RIBASSISTA" | "NEUTRALE"
  // (validato dallo schema Zod della route; String a schema per flessibilità).
  biasXau String
  biasWti String
  biasIdx String

  // Confidenza 0-100 per asset
  confidenceXau Int
  confidenceWti Int
  confidenceIdx Int

  summary String? // sintesi breve per le card
  payload Json // report completo, per il dettaglio in pagina

  // ───── Scorecard a Expected Move (payload v2) ─────
  // Campi ADDITIVI: i report v1 restano validi e li lasciano a null.
  // Vengono conservati come JSON e letti da un parser difensivo
  // (src/lib/macro-desk-bias-record.ts), stessa convenzione già usata per il
  // payload del dettaglio: il desk è un sistema esterno, la sua forma può
  // cambiare e l'app non deve rompersi né perdere dati.

  /**
   * Versione dello schema inviato dal desk. null = legacy v1.
   */
  schemaVersion     Int?
  /**
   * false = report informativo, fuori da OGNI conteggio della scorecard.
   */
  scorecardEligible Boolean?
  /**
   * Prima riga del nuovo track record (una sola volta).
   */
  trackRecordStart  Boolean  @default(false)
  /**
   * Weekly Bias Record: la dichiarazione della settimana + il monitoraggio.
   */
  biasRecord        Json?
  /**
   * Verdetto del desk sulla settimana conclusa (solo WEEKLY).
   */
  resolved          Json?
  /**
   * Stato giornaliero degli asset (solo DAILY).
   */
  monitor           Json?
  /**
   * Modifiche all'IMPEGNO DELLA DOMENICA che questo report ha tentato e che
   * l'endpoint ha rifiutato: bias, p0, em o soglie dei rami diversi da quelli
   * gia' registrati per la stessa settimana. `null` = nessuna discrepanza.
   * Si conserva invece di limitarsi a loggare perche' il difetto da togliere
   * non era la sovrascrittura ma il fatto che avvenisse in silenzio: una riga
   * di log che nessuno legge non e' un miglioramento.
   * Regola in `src/lib/macro-desk-impegno.ts`.
   */
  impegnoRifiutato  Json?
  /**
   * RILIEVI DELLA SENTINELLA: quel che nel report non rispetta il contratto e
   * che pero' NON e' motivo di rifiuto (news senza titolo, entita' HTML nei
   * testi, confidenza dichiarata due volte con due valori, synthesis nella
   * forma sbagliata). `null` = report in regola.
   * Esiste per il report del 18/08/2026: arrivo' con 11 news su 11 senza
   * titolo, fu accettato e servito, e nessuno lo seppe per dieci giorni.
   * Regola in `src/lib/macro-desk-contratto.ts`.
   */
  rilieviContratto  Json?

  /**
   * Storico append-only delle versioni arrivate per questo report.
   * Relazione, non colonna: la riga di `MacroDeskReport` resta identica.
   */
  versioni MacroDeskReportVersione[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, reportDate])
}

/**
 * IL JOURNAL DELLE VERSIONI — append-only, mai aggiornato, mai cancellato.
 *
 * L'upsert su (type, reportDate) e' idempotente per scelta e resta tale: il
 * re-invio dello stesso giorno SOSTITUISCE la riga. Comodo e giusto per la
 * lettura, ma il 28/08/2026 ha mostrato il costo: il report delle 04:22 e'
 * sparito quando alle 14:59 e' arrivata la versione delle 14:46. Con lui sono
 * sparite le prove del difetto (confidenza 44 contro 45 nel record, entita'
 * HTML, news senza url) E la prova che il difetto era stato corretto.
 *
 * Questa tabella conserva OGNI arrivo. Nessuna lettura esistente la tocca:
 * le pagine continuano a leggere `MacroDeskReport`, che resta la versione
 * corrente. E' archivio, non sorgente.
 *
 * `arrivatoIl` non e' `generatedAt`: il primo dice quando la versione e'
 * ENTRATA, il secondo quando il desk dichiara di averla prodotta. Sulla riga
 * del 28/08 `createdAt` era rimasto alle 09:43 mentre `generatedAt` diceva
 * 14:46 — una riga che non sapeva piu' dire quando era arrivata.
 */
model MacroDeskReportVersione {
  id       String          @id @default(cuid())
  reportId String
  report   MacroDeskReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /** Istante dichiarato dal desk per QUESTA versione. */
  generatedAt DateTime
  /** Istante in cui la versione e' entrata: lo mette il database, non il desk. */
  arrivatoIl  DateTime @default(now())

  /** Il report completo di questa versione, come spedito. */
  payload    Json
  /** Blocchi v2 di questa versione; `null` quando non arrivano. */
  biasRecord Json?
  monitor    Json?
  /** Rilievi della sentinella su QUESTA versione. */
  rilievi    Json?

  /** Lo storico di un report si legge in ordine di arrivo. */
  @@index([reportId, arrivatoIl])
}

// ───────────────────────── COT (posizionamento futures) ─────────────────────────

enum CotInstrument {
  GOLD
  WTI
}

// Storico settimanale CFTC (Disaggregated Futures Only): open interest e
// posizioni nette Managed Money / Producer-Merchant. Dato di MERCATO unico
// per l'istanza, NON per utente: nessun userId, come MacroDeskReport.
// Chiave logica (instrument, reportDate): APPEND-ONLY — il job settimanale
// aggiunge settimane nuove e non sovrascrive mai quelle già salvate.
model CotWeek {
  id         String        @id @default(cuid())
  instrument CotInstrument
  reportDate DateTime      @db.Date // martedì di riferimento del report (mezzanotte UTC)

  // Contratti (conteggi interi, non denaro): open interest totale e netti long-short.
  openInterest Int
  mmNet        Int // Managed Money: long − short
  prodNet      Int // Producer/Merchant: long − short

  createdAt DateTime @default(now())

  @@unique([instrument, reportDate])
}

// ORFANA dal 26/08/2026 — nessun codice la scrive né la legge più.
// Conteneva i titoli settimanali presi da Google News per il pannello COT:
// il percorso è stato rimosso (selezione non qualificabile, nessuna licenza
// di ripubblicazione; motivo esteso in components/macro-desk/cot-panel.tsx).
// La tabella resta in piedi con lo storico già scritto perché cancellare dati
// è una decisione di chi possiede il database, non di una revisione della UI:
// la voce è registrata in docs/DEBITO-TECNICO.md in attesa di un drop.
model CotContestoBox {
  id           String   @id @default(cuid())
  /**
   * Martedì di riferimento della settimana COT commentata (mezzanotte UTC).
   */
  settimanaCot DateTime @db.Date
  generatedAt  DateTime @default(now())
  /**
   * Contenuto validato da Zod (src/lib/cot-contesto.ts): contesto per
   * strumento con fonti; le implicazioni meccaniche NON stanno qui (tabella
   * statica nel codice, ricavata a render-time dalla banda corrente).
   */
  contenuto    Json

  @@unique([settimanaCot])
}

// ───────────────────────── Sync MetaTrader 5 ─────────────────────────

// Una sorgente di sync per conto di trading: il watcher in-app osserva il
// file NDJSON scritto dall'EA e importa i trade nuovi (dedup su brokerTicketId).
model Mt5SyncSource {
  id               String     @id @default(cuid())
  userId           String
  tradingAccountId String     @unique // un conto ↔ una sorgente
  filePath         String // percorso assoluto del file .ndjson scritto dall'EA
  assetClass       AssetClass @default(FOREX) // asset class di default dei trade importati
  enabled          Boolean    @default(true)
  lastSyncAt       DateTime?
  lastResult       Json? // { imported, duplicates, failed[], divergences[], error? }

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ───────────────────── Stagionalità di MERCATO ─────────────────────
//
// Comportamento storico degli STRUMENTI, non dei trade dell'utente: nessun
// userId in tutto il blocco, come MacroDeskReport e CotWeek. Il dato è unico
// per l'istanza e arriva da un job notturno.
//
// Architettura in tre strati:
//  1. barre grezze (SeasonalityDailyBar / SeasonalityHourBar) — SOLO lato
//     server, mai esposte alla UI né scaricabili: i ToS di Dukascopy e CBOE
//     consentono l'uso derivato, non la ridistribuzione del grezzo;
//  2. statistiche compatte (SeasonalityStat / SeasonalityPathPoint) —
//     precalcolate dal job, è l'unica cosa che la pagina legge;
//  3. copertura e diario delle esecuzioni (SeasonalityCoverage /
//     SeasonalityRun) — per dichiarare in UI da dove viene il dato, fino a
//     quando arriva e cosa è fallito.

enum SeasonalityInstrument {
  // Prezzi: analisi sui RENDIMENTI, drill fino all'ora.
  XAUUSD
  WTI
  GER40
  SPX
  // Indici di volatilità: analisi sul LIVELLO, solo mese/settimana/giorno.
  GVZ
  OVX
  VDAX
  VIX
  // Struttura a termine della volatilità: stessa famiglia del VIX, raccolti
  // per il confronto fra scadenze. Fuori dalla Stagionalità in UI (v.
  // `fuoriDallaStagionalita`): servono come serie, non come schede.
  VIX9D
  VIX3M
  // Clima di copertura sull'azionario: prima arrivavano dal report
  // giornaliero, copiati a mano. Solo CBOE, senza riserva (FRED 404).
  VVIX
  SKEW
  // WTI dal future front-month. NON sostituisce `WTI` (spot Cushing): le due
  // serie hanno rendimenti correlati 0,94, non 1, e sostituire sposterebbe
  // ogni statistica stagionale gia pubblicata. Convivono, ciascuna dove e
  // corretta — v. `docs/DEBITO-TECNICO.md`.
  WTIFUT
}

enum SeasonalityKind {
  RETURN // rendimenti log dei prezzi
  LEVEL // livello medio dell'indice di volatilità
}

enum SeasonalityGranularity {
  MONTH // mese dell'anno 1-12
  WEEK // settimana ISO 1-53
  WEEKDAY // giorno della settimana 1-5 (lun-ven)
  SESSION // 0-3, indice in SESSIONS (Asia/Londra/New York/fuori sessione)
  HOUR // ora 0-23
}

// Orologio dei bucket INTRADAY. Le granularità basate sulla data (mese,
// settimana, giorno) non hanno fuso: per loro vale sempre ROME, riga unica.
// Per HOUR esistono entrambe le versioni PRECALCOLATE — il toggle in UI
// cambia riga, non rietichetta: rietichettare sarebbe sbagliato, tra CET e
// CEST lo scarto Roma↔UTC vale un'ora e cambia dentro l'anno.
enum SeasonalityClock {
  UTC
  ROME
}

// Barre giornaliere grezze. Chiave logica (instrument, date): il job
// riscrive solo le date nuove o cambiate (le fonti revisionano il passato).
//
// `close` è OBBLIGATORIA e resta il motore di tutto ciò che esisteva prima:
// rendimenti, stagionalità, volatilità realizzata. Nessun calcolo storico
// cambia valore per il fatto che ora ci sono anche le altre tre.
//
// `open/high/low` sono NULLABILI, e non per pigrizia: non tutte le fonti le
// pubblicano. FRED espone serie a valore singolo (WTI spot Cushing, VIX, GVZ,
// OVX): per quegli strumenti la chiusura è tutto ciò che esiste, e una colonna
// vuota è la rappresentazione onesta del fatto. Dukascopy e Yahoo le danno
// tutte e quattro. Chi consuma high/low deve dichiarare su quale campione sta
// lavorando invece di mescolare in silenzio giorni con e senza il dato.
model SeasonalityDailyBar {
  instrument SeasonalityInstrument
  date       DateTime              @db.Date
  close      Decimal               @db.Decimal(18, 8)
  open       Decimal?              @db.Decimal(18, 8)
  high       Decimal?              @db.Decimal(18, 8)
  low        Decimal?              @db.Decimal(18, 8)
  // Quando la riga e' stata scritta. Le barre si riscrivono per INTERO a ogni
  // giro (deleteMany + createMany), quindi questo e' il timestamp
  // dell'ingestione che l'ha prodotta. Esiste per una domanda precisa: il
  // 26/08/2026 tutto il 2005 dell'oro e' sparito in una riscrittura e per
  // datarla si e' dovuto interrogare `xmin`, l'identificativo di transazione
  // fisica di Postgres — che funziona, ma e' un dettaglio del motore e sparisce
  // a ogni VACUUM FULL. La prossima volta la risposta e' una colonna.
  writtenAt  DateTime              @default(now())

  @@id([instrument, date])
}

// Chiusure orarie grezze (solo strumenti di prezzo, sorgente Dukascopy).
// `ts` è l'INIZIO dell'ora in UTC: il fuso di visualizzazione si applica in
// fase di bucketing, mai al dato salvato.
model SeasonalityHourBar {
  instrument SeasonalityInstrument
  ts         DateTime              @db.Timestamptz(3)
  close      Decimal               @db.Decimal(18, 8)

  @@id([instrument, ts])
}

// Una riga = un bucket stagionale con le sue statistiche oneste.
// `scope` è il filtro del drill: "ALL" oppure "M01".."M12" (dentro quel mese).
// `bucket` è l'indice dentro la granularità (mese 1-12, settimana ISO 1-53,
// giorno 1-5, sessione 0-3, ora 0-23).
model SeasonalityStat {
  instrument    SeasonalityInstrument
  kind          SeasonalityKind
  granularity   SeasonalityGranularity
  clock         SeasonalityClock
  scope         String
  lookbackYears Int
  detrended     Boolean
  bucket        Int

  /**
   * Numerosità del campione: SEMPRE mostrata, è il metro dell'affidabilità.
   * È il numero di ANNI — l'unità statistica è la casella della griglia.
   */
  n             Int
  /**
   * Osservazioni GREZZE dietro le medie annue (giorni di quotazione, o ore
   * per l'intraday). Informazione aggiuntiva, mai il denominatore.
   */
  rawCount      Int?
  /**
   * RETURN: media dei rendimenti log. LEVEL: livello medio.
   */
  mean          Decimal  @db.Decimal(18, 8)
  median        Decimal  @db.Decimal(18, 8)
  /**
   * Deviazione standard campionaria (n-1); null con n < 2.
   */
  stdev         Decimal? @db.Decimal(18, 8)
  /**
   * RETURN: quota di osservazioni positive. LEVEL: quota sopra la mediana
   * di tutto il periodo (un hit rate sul livello non avrebbe senso).
   */
  positiveShare Decimal  @db.Decimal(18, 8)
  p25           Decimal  @db.Decimal(18, 8)
  p75           Decimal  @db.Decimal(18, 8)
  /**
   * Copertura EMPIRICA della banda media±1σ: quota di osservazioni davvero
   * dentro [media−σ, media+σ]. Si mostra questa, mai il 68% teorico — stessa
   * scelta del simulatore di equity. Null quando σ non è definita (n < 2).
   */
  withinSigma   Decimal? @db.Decimal(18, 8)

  firstDate DateTime @db.Date
  lastDate  DateTime @db.Date

  @@id([instrument, granularity, clock, scope, lookbackYears, detrended, bucket])
}

// Percorso stagionale medio dentro l'anno: rendimento log CUMULATO dal 1°
// gennaio al giorno `dayOfYear`, mediato sugli anni della finestra, con le
// bande di dispersione (p25/p75) per non far sembrare una media una regola.
model SeasonalityPathPoint {
  instrument    SeasonalityInstrument
  lookbackYears Int
  detrended     Boolean
  dayOfYear     Int

  meanCum       Decimal @db.Decimal(18, 8)
  medianCum     Decimal @db.Decimal(18, 8)
  p25Cum        Decimal @db.Decimal(18, 8)
  p75Cum        Decimal @db.Decimal(18, 8)
  /**
   * Quota di anni sopra lo zero (o sopra la mediana, per i livelli) a
   * questo punto dell'anno: senza, la linea media sarebbe una media nuda.
   */
  positiveShare Decimal @default(0) @db.Decimal(18, 8)
  /**
   * Anni che contribuiscono a questo punto.
   */
  n             Int

  @@id([instrument, lookbackYears, detrended, dayOfYear])
}

// Stato corrente per strumento: la UI lo mostra così l'utente sa da dove
// viene il numero e quanto è fresco. Una riga per strumento, riscritta ogni
// esecuzione del job.
model SeasonalityCoverage {
  instrument SeasonalityInstrument @id
  kind       SeasonalityKind

  /**
   * Etichetta della sorgente che ha effettivamente risposto (es. "FRED DCOILWTICO").
   */
  dailySource String?
  dailyFirst  DateTime? @db.Date
  dailyLast   DateTime? @db.Date
  dailyRows   Int       @default(0)

  hourSource String?
  hourFirst  DateTime? @db.Timestamptz(3)
  hourLast   DateTime? @db.Timestamptz(3)
  hourRows   Int       @default(0)

  /**
   * Ultimo precalcolo andato a buon fine per questo strumento.
   */
  computedAt DateTime?
  /**
   * Motivo dichiarato quando il dato GIORNALIERO manca o è parziale.
   */
  note       String?
  /**
   * Copertura dell'archivio ORARIO (mesi assenti). Campo separato da `note`:
   * un errore sul giornaliero e un buco nell'intraday sono due notizie
   * diverse, e prima si sovrascrivevano a vicenda.
   */
  hourNote   String?

  updatedAt DateTime @updatedAt
}

// Diario delle esecuzioni del job notturno: serve a capire dai log e dalla
// pagina se il dato è fermo e perché.
model SeasonalityRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  /**
   * Esito per strumento: righe ingerite, sorgente, errori.
   */
  detail     Json?

  @@index([startedAt])
}

// Una riga per (strumento, granularità, anno, bucket): è ciò che alimenta le
// HEATMAP anni × {mesi | settimane | giorni}, che per definizione mostrano le
// singole osservazioni e non un'aggregazione — le righe finali Media / StDev /
// Pos% / n arrivano invece da `SeasonalityStat`, così lo stesso numero non ha
// due fonti di verità.
//
// `year` è l'anno civile per MONTH e WEEKDAY, e l'anno ISO per WEEK: la
// settimana a cavallo di capodanno appartiene per intero a uno solo dei due
// anni, ed è quello ISO (vedi `isoWeekYear`).
//
// `value` segue il tipo dello strumento, come ovunque nel modulo:
// - RETURN → rendimento LOG del periodo (mese/settimana), oppure rendimento
//   log MEDIO dei giorni di quella settimana (WEEKDAY);
// - LEVEL  → livello MEDIO nel periodo.
model SeasonalityYearBucketObs {
  instrument  SeasonalityInstrument
  granularity SeasonalityGranularity
  /**
   * Rilevante solo per HOUR, che esiste in due versioni precalcolate.
   * Per tutte le altre granularità vale ROME, riga unica.
   */
  clock       SeasonalityClock       @default(ROME)
  year        Int
  bucket      Int

  value Decimal @db.Decimal(18, 8)
  /**
   * Giorni di quotazione che compongono l'osservazione: un mese con 3 giorni
   * di dati non è un mese, e la heatmap deve poterlo marcare invece di
   * colorarlo come gli altri.
   */
  days  Int

  @@id([instrument, granularity, clock, year, bucket])
}

// Stato di avanzamento del job, per strumento: è il CURSORE che rende il
// primo caricamento ripartibile.
//
// Senza, il job ricomincia da capo a ogni invocazione e su una funzione con
// un limite di tempo non arriva mai in fondo: scarica, viene ucciso, e la
// notte dopo riscarica le stesse cose. Con il cursore ogni invocazione fa un
// pezzo e lo dichiara, e più esecuzioni convergono.
/**
 * Media stagionale di un QUARTO D'ORA per (strumento, orologio, anno).
 * È l'unica traccia che resta delle barre M15: il grezzo — milioni di righe
 * per strumento — viene scaricato, aggregato e BUTTATO nella stessa
 * invocazione. Qui restano 96 bucket × ~23 anni × 2 orologi per strumento,
 * cioè qualche migliaio di righe in tutto, da cui qualunque finestra di
 * lookback si ricava con una media.
 * Serve SOLO al grafico del ritorno intraday: le tabelle e la heatmap della
 * vista Ora restano sulle barre H1, con le loro statistiche complete.
 */
model SeasonalityQuarterYear {
  instrument SeasonalityInstrument
  clock      SeasonalityClock
  year       Int
  /**
   * Quarto d'ora dalla mezzanotte dell'orologio scelto: 0..95.
   */
  bucket     Int

  /**
   * Media dei rendimenti log di quel quarto d'ora in quell'anno.
   */
  mean Decimal @db.Decimal(18, 12)
  /**
   * Barre M15 che la compongono: il campione grezzo, dichiarato.
   */
  bars Int

  @@id([instrument, clock, year, bucket])
}

// ───────────────────── Driver Desk (Macro Desk) ─────────────────────
//
// Chiusure giornaliere delle serie del Driver Desk (forza nel paniere,
// contesto driver, stabilità delle relazioni). Dato di MERCATO unico per
// l'istanza, nessun userId — come MacroDeskReport, CotWeek e Stagionalità.
// Blocco ADDITIVO: non tocca nessuna tabella esistente.
// Spec congelata: docs/driver-desk/SPEC_driver_desk_v1.0.md.

enum DriverDeskSeries {
  XAUUSD
  XAGUSD
  WTI
  BRENT
  GER40
  STOXX50E
  CAC40
  SPX
  DFII10
  T10YIE
  DTWEXBGS
  EURUSD
  BUND10Y
  // Nominale USA a dieci anni: serve allo spread contro il Bund, che è il
  // canale con cui il differenziale di tassi si trasmette all'euro e da lì
  // agli esportatori del DAX.
  DGS10
}

// Chiusure giornaliere grezze. Chiave (series, date): l'ingest sostituisce
// integralmente la serie (le fonti revisionano il passato). SOLO lato server,
// mai esposte alla UI né scaricabili — stessa disciplina delle barre
// Stagionalità. Lo spread WTI−Brent NON si salva: si deriva a calcolo.
model DriverDeskBar {
  series DriverDeskSeries
  date   DateTime         @db.Date
  value  Decimal          @db.Decimal(18, 8)

  @@id([series, date])
}

// Stato per serie: la UI dichiara da dove viene il dato e quanto è fresco,
// stesso ruolo di SeasonalityCoverage.
model DriverDeskCoverage {
  series    DriverDeskSeries @id
  /**
   * Etichetta della fonte che ha davvero risposto (es. "FRED DFII10").
   */
  source    String?
  firstDate DateTime?        @db.Date
  lastDate  DateTime?        @db.Date
  rows      Int              @default(0)
  /**
   * Motivo dichiarato quando il dato manca o è parziale.
   */
  note      String?
  updatedAt DateTime         @updatedAt
}

model SeasonalityJobState {
  instrument SeasonalityInstrument @id

  /**
   * Ultimo giornaliero portato a termine: sotto le 20 ore non si rifà.
   */
  dailyDoneAt DateTime?

  /**
   * Prossimo anno da scaricare per l'intraday. `null` = mai iniziato.
   * È un anno e non un timestamp perché l'ingest procede a blocchi annuali:
   * un anno interamente vuoto (l'inizio di uno storico) non farebbe avanzare
   * un cursore basato sull'ultima barra salvata, e il job resterebbe fermo
   * a rileggere il vuoto per sempre.
   */
  hourNextYear Int?

  /**
   * L'ingest orario ha raggiunto il presente: da qui in poi solo il delta.
   */
  hourIngestComplete Boolean @default(false)

  /**
   * Prossimo anno da scaricare per i quarti d'ora (M15). Stesso schema del
   * cursore orario, tabella diversa: il grezzo M15 non si conserva, quindi
   * l'unico stato che avanza è questo.
   */
  quarterNextYear Int?

  /**
   * L'ingest M15 ha raggiunto il presente.
   */
  quarterIngestComplete Boolean @default(false)

  /**
   * Ultimo anno ricalcolato dai quarti d'ora: l'anno in corso si rifà.
   */
  quarterDoneAt DateTime?

  /**
   * Righe orarie al momento dell'ultimo precalcolo. Se non sono cambiate il
   * precalcolo non si rifà: a regime è il risparmio che tiene il job dentro
   * il budget.
   */
  hourRowsAtCompute Int       @default(0)
  hourComputedAt    DateTime?

  updatedAt DateTime @updatedAt
}

// ───────────────────────── Radar di settore ─────────────────────────
//
// Registro SETTIMANALE dei cambiamenti dell'ecosistema operativo del trading
// (borse, prop firm, broker, regolatori, piattaforme, dati). Non parla di
// prezzi: è l'unica sezione del Macro Desk che non guarda il mercato.
//
// Dato unico per l'istanza, NON per utente: nessun userId, come
// MacroDeskReport e CotWeek.
//
// Chiave logica: `weekOf` (la domenica della settimana del run). Il reinvio
// della stessa settimana AGGIORNA la riga e RIFÀ i figli — mai duplicati.
//
// PRINCIPIO DEL ROUND-26: qui si persistono FATTI, non verdetti. Nessuna
// probabilità, nessun punteggio, nessun giudizio calcolato dall'app: le
// uniche cose che l'app deriva sono conteggi verificabili (da quante
// settimane un'area non è verificabile) e formattazione.

model RadarReport {
  id String @id @default(cuid())

  /**
   * Domenica della settimana del run (mezzanotte UTC). Chiave di unicità.
   */
  weekOf      DateTime @unique @db.Date
  generatedAt DateTime

  // ───── Finestra osservata ─────
  // Va mostrata SEMPRE in pagina, insieme al fatto che sia stata estesa: un
  // registro settimanale che copre 14 giorni invece di 7 non è la stessa cosa,
  // e chi legge deve saperlo senza aprire le note.
  windowFrom     DateTime @db.Date
  windowTo       DateTime @db.Date
  windowExtended Boolean  @default(false)

  /**
   * Elementi guardati e scartati dal filtro: numero, non giudizio.
   */
  discarded Int?
  /**
   * Note del run: cosa è stato guardato, cosa non si è raggiunto.
   */
  notes     String?

  /**
   * Payload integrale come ricevuto, non normalizzato: la forma del task
   * esterno evolve e nulla va perso. Le colonne sopra sono la parte che la
   * pagina legge; questa è la copia fedele.
   */
  payload Json

  highlights   RadarHighlight[]
  changes      RadarChange[]
  readings     RadarReading[]
  watches      RadarWatch[]
  emptyAreas   RadarEmptyArea[]
  unverifiable RadarUnverifiableArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// «Le cose che contano», ciascuna con l'azione conseguente. Non hanno un
// id-slug nel payload (sono una selezione della settimana, non voci di
// registro): la chiave è la posizione.
model RadarHighlight {
  id       String      @id @default(cuid())
  reportId String
  report   RadarReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  ordine Int
  /**
   * Aggancio alla voce del registro (`RadarChange.slug` / `RadarReading.slug`).
   * Dal 27/08/2026 le voci di `top[]` portano un `id` nel payload e questo è
   * quel valore. Prima non c'era: il blocco delle voci in evidenza era una
   * card separata che RIPETEVA il testo della riga, e l'unico modo di
   * appaiarli sarebbe stato l'URL della fonte. Ora l'evidenza non è più un
   * blocco: è una marcatura sulla riga, e questo campo è ciò che la lega.
   * Nullable per le righe scritte prima (riempite dalla migrazione).
   */
  slug   String?

  /**
   * Conservati ma non più rappresentati: l'evidenza non ha un testo proprio,
   * ha solo l'azione. Restano perché cancellare dati non è una decisione di
   * una revisione della UI.
   */
  title       String
  whatChanged String

  /**
   * L'azione conseguente: è la SOLA cosa che l'evidenza aggiunge alla voce.
   */
  action     String
  sourceUrl  String?
  sourceName String?

  @@unique([reportId, ordine])
  @@index([reportId])
  @@index([slug])
}

// Una voce del registro: un cambiamento operativo osservato nella finestra.
//
// `slug` è l'id stabile FRA SETTIMANE (arriva dal campo `id` del payload):
// serve alla deduplica del task a monte e a mostrare l'evoluzione di una voce
// da "annunciato" ad "attivo". Per questo l'indice è su `slug` da solo, non
// solo sulla coppia col report.
model RadarChange {
  id       String      @id @default(cuid())
  reportId String
  report   RadarReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  slug        String
  /**
   * Area dell'ecosistema (A-G). String e non enum: una lettera nuova non
   * deve far cadere l'ingest — la pagina rende l'ignoto com'è.
   */
  area        String
  title       String
  whatChanged String
  /**
   * Chi ha fatto il cambiamento. Opzionale: i payload attuali non lo
   * mandano e la pagina lo ricava dalla fonte (vedi `chiDallaFonte`).
   */
  who         String?

  announcedOn   DateTime? @db.Date
  /**
   * `null` legittimo: annunciato senza data di efficacia dichiarata.
   */
  effectiveFrom DateTime? @db.Date
  /**
   * "annunciato" | "attivo" | … — String per la stessa ragione di `area`.
   */
  status        String

  impact     String?
  /**
   * LIMITE DI LETTURA DELLA FONTE, non una conseguenza operativa.
   * «Tick size e margini non sono indicati nelle pagine pubbliche consultate»
   * non dice cosa cambia per chi opera: dice fin dove si è riusciti a
   * leggere. Finiva impastato dentro `impact`, e mescolava due cose che
   * questa sezione esiste apposta per tenere separate — quello che si sa da
   * quello che non si è potuto sapere.
   */
  caveat     String?
  sourceUrl  String?
  sourceName String?

  /**
   * Campi del payload non previsti da queste colonne: conservati, mai persi.
   */
  extra  Json?
  ordine Int

  @@unique([reportId, slug])
  @@index([slug])
  @@index([reportId])
}

// «Letture» — l'area G. TABELLA PROPRIA, non un flag su RadarChange.
//
// Un paper non è un cambiamento operativo: non ha una data di efficacia, non
// impone niente, non si agisce. Se condividesse la tabella con i cambiamenti,
// prima o poi qualcuno le renderebbe insieme — e la pagina direbbe che è
// successo qualcosa quando è solo uscito uno studio.
model RadarReading {
  id       String      @id @default(cuid())
  reportId String
  report   RadarReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  slug        String
  area        String
  title       String
  whatChanged String
  impact      String?
  /**
   * Come su RadarChange: fin dove si è riusciti a leggere la fonte.
   */
  caveat      String?
  publishedOn DateTime? @db.Date
  sourceUrl   String?
  sourceName  String?

  extra  Json?
  ordine Int

  @@unique([reportId, slug])
  @@index([slug])
  @@index([reportId])
}

// «In osservazione»: annunciato ma non ancora osservabile, o in attesa di una
// data. Stesso id-slug stabile dei cambiamenti, così una voce che passa da
// osservazione a registro si riconosce.
model RadarWatch {
  id       String      @id @default(cuid())
  reportId String
  report   RadarReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  slug   String
  area   String?
  title  String
  note   String?
  status String?

  sourceUrl  String?
  sourceName String?

  extra  Json?
  ordine Int

  @@unique([reportId, slug])
  @@index([slug])
  @@index([reportId])
}

// ───── Aree senza esito: DUE tabelle, e non una con una colonna «tipo» ─────
//
// «Area guardata, nessuna novità» e «area che non si è potuto verificare» non
// sono la stessa cosa e non devono MAI diventarlo nell'interfaccia: la prima
// è un risultato, la seconda è un avviso che la fonte non è stata letta.
//
// Con una tabella sola e un discriminatore, renderle uguali sarebbe una
// dimenticanza (`if` non scritto). Con due tabelle separate va scritto
// apposta il codice che le confonde. La struttura difende il requisito.

/**
 * Area guardata, fonti enumerate, nessuna novità nella finestra. RISULTATO.
 */
model RadarEmptyArea {
  id       String      @id @default(cuid())
  reportId String
  report   RadarReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  area   String
  ordine Int

  @@unique([reportId, area])
  @@index([reportId])
}

/**
 * Area che NON si è potuto verificare: la fonte non è stata letta. AVVISO.
 * `reason` è obbligatorio — un «non verificabile» senza motivo è
 * indistinguibile da un «vuoto», ed è il caso che il confine rifiuta.
 * L'indice su `area` serve a contare da quante settimane consecutive l'area
 * risulta non verificabile: ripetuta identica, l'avviso diventa rumore.
 */
model RadarUnverifiableArea {
  id       String      @id @default(cuid())
  reportId String
  report   RadarReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  area   String
  reason String
  ordine Int

  @@unique([reportId, area])
  @@index([area])
  @@index([reportId])
}
